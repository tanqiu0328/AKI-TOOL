{
  "name": "aki-tool",
  "version": "0.1.0",
  "description": "AKI-TOOL desktop utility suite.",
  "author": "AKI",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "npm-run-all --parallel dev electron:watch",
    "electron:watch": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "build:preload": "esbuild electron/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run test:typecheck && node --test tests/lowerBoardSimulation.test.ts tests/previewLowerBoardSim.test.ts tests/electronLowerBoardSimAdapter.test.ts tests/previewEspToolAdapter.test.ts tests/electronEspToolAdapter.test.ts tests/electronCustomFlashAdapter.test.ts tests/customFlashBackend.test.ts tests/lowerBoardSimulator.ui.test.mjs tests/customFlash.ui.test.mjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.node.json && npm run build:preload",
    "capture:ui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/capture-ui.ps1",
    "start": "electron .",
    "smoke:packaged": "node scripts/smoke-ui-cdp.mjs --packaged",
    "dist": "npm run build && npx electron-builder --win nsis portable && npm run smoke:packaged",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.21.5",
    "jsdom": "^26.1.0",
    "npm-run-all": "4.1.5",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.aki.tool",
    "productName": "AKI-TOOL",
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/esp-flasher",
        "to": "esp-flasher",
        "filter": [
          "**/*",
          "!logs/**",
          "!flash_tool.config.json"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
